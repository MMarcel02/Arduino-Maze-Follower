<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.project1.GUIController"
      spacing="10"
      fillWidth="true"
      prefWidth="800" prefHeight="600"
      VBox.vgrow="ALWAYS">

    <children>


        <HBox spacing="10" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
            <children>


                <AnchorPane HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox spacing="10"
                              AnchorPane.topAnchor="10"
                              AnchorPane.bottomAnchor="10"
                              AnchorPane.leftAnchor="10"
                              AnchorPane.rightAnchor="10"
                              VBox.vgrow="ALWAYS">


                            <HBox spacing="20">
                                <children>
                                    <Label text="Values" textAlignment="CENTER">
                                        <font><Font size="18"/></font>
                                        <textFill><Color red="0.624" green="0.624" blue="0.624"/></textFill>
                                    </Label>
                                </children>
                            </HBox>


                             <VBox spacing="5">
                                <children>

                                    <HBox spacing="5">
                                        <children>
                                            <Label text="IR Left:"/>
                                            <Label fx:id="irLeftLabel" text="-" />
                                        </children>
                                    </HBox>

                                    <HBox spacing="5">
                                        <children>
                                            <Label text="IR Right:"/>
                                            <Label fx:id="irRightLabel" text="-" />
                                        </children>
                                    </HBox>

                                    <HBox spacing="5">
                                        <children>
                                            <Label text="Ultrasound:"/>
                                            <Label fx:id="distanceLabel" text="-" />
                                        </children>
                                    </HBox>

                                </children>
                            </VBox>


                            <VBox spacing="10">
                                <children>

                                    <Slider fx:id="speedSlider" max="255" value="80"/>

                                    <Label fx:id="speedLabel" text="Speed: 80"/>

                                    <GridPane hgap="4" vgap="4">
                                        <columnConstraints>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                        </columnConstraints>
                                        <rowConstraints>
                                            <RowConstraints vgrow="ALWAYS"/>
                                        </rowConstraints>

                                        <children>
                                            <Button fx:id="bigDecrement" maxWidth="Infinity" maxHeight="Infinity"
                                                    onMousePressed="#bigDecreaseSpeed">
                                                <graphic><FontIcon iconLiteral="fas-minus" styleClass="buttonIcon"/></graphic>
                                            </Button>

                                            <Button fx:id="smallDecrement" maxWidth="Infinity" maxHeight="Infinity"
                                                    GridPane.columnIndex="1"
                                                    onMousePressed="#smallDecreaseSpeed">
                                                <graphic><FontIcon iconLiteral="fas-minus" styleClass="smallButtonIcon"/></graphic>
                                            </Button>

                                            <Button fx:id="smallIncrement" maxWidth="Infinity" maxHeight="Infinity"
                                                    GridPane.columnIndex="2"
                                                    onMousePressed="#smallIncreaseSpeed">
                                                <graphic><FontIcon iconLiteral="fas-plus" styleClass="smallButtonIcon"/></graphic>
                                            </Button>

                                            <Button fx:id="bigIncrement" maxWidth="Infinity" maxHeight="Infinity"
                                                    GridPane.columnIndex="3"
                                                    onMousePressed="#bigIncreaseSpeed">
                                                <graphic><FontIcon iconLiteral="fas-plus" styleClass="buttonIcon"/></graphic>
                                            </Button>
                                        </children>
                                    </GridPane>

                                </children>
                            </VBox>


                            <VBox spacing="10">
                                <children>

                                    <Label text="Controls" textAlignment="CENTER"/>

                                    <Label fx:id="activeInputsLabel" text="Active:" wrapText="true"/>

                                    <GridPane hgap="4" vgap="4">
                                        <columnConstraints>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                        </columnConstraints>
                                        <rowConstraints>
                                            <RowConstraints vgrow="ALWAYS"/>
                                            <RowConstraints vgrow="ALWAYS"/>
                                        </rowConstraints>

                                        <children>

                                            <Button fx:id="crabWalkLeft" maxWidth="Infinity" maxHeight="Infinity"
                                                    onMousePressed="#onButtonPressed" onMouseReleased="#onButtonReleased">
                                                <graphic><FontIcon iconLiteral="fas-angle-double-left" styleClass="buttonIcon"/></graphic>
                                            </Button>

                                            <Button fx:id="upArrow" maxWidth="Infinity" maxHeight="Infinity"
                                                    GridPane.columnIndex="1"
                                                    onMousePressed="#onButtonPressed" onMouseReleased="#onButtonReleased">
                                                <graphic><FontIcon iconLiteral="fas-arrow-up" styleClass="buttonIcon"/></graphic>
                                            </Button>

                                            <Button fx:id="crabWalkRight" maxWidth="Infinity" maxHeight="Infinity"
                                                    GridPane.columnIndex="2"
                                                    onMousePressed="#onButtonPressed" onMouseReleased="#onButtonReleased">
                                                <graphic><FontIcon iconLiteral="fas-angle-double-right" styleClass="buttonIcon"/></graphic>
                                            </Button>

                                            <Button fx:id="leftArrow" maxWidth="Infinity" maxHeight="Infinity"
                                                    GridPane.rowIndex="1"
                                                    onMousePressed="#onButtonPressed" onMouseReleased="#onButtonReleased">
                                                <graphic><FontIcon iconLiteral="fas-arrow-left" styleClass="buttonIcon"/></graphic>
                                            </Button>

                                            <Button fx:id="downArrow" maxWidth="Infinity" maxHeight="Infinity"
                                                    GridPane.columnIndex="1" GridPane.rowIndex="1"
                                                    onMousePressed="#onButtonPressed" onMouseReleased="#onButtonReleased">
                                                <graphic><FontIcon iconLiteral="fas-arrow-down" styleClass="buttonIcon"/></graphic>
                                            </Button>

                                            <Button fx:id="rightArrow" maxWidth="Infinity" maxHeight="Infinity"
                                                    GridPane.columnIndex="2" GridPane.rowIndex="1"
                                                    onMousePressed="#onButtonPressed" onMouseReleased="#onButtonReleased">
                                                <graphic><FontIcon iconLiteral="fas-arrow-right" styleClass="buttonIcon"/></graphic>
                                            </Button>

                                        </children>
                                    </GridPane>

                                    <Button fx:id="stopButton" onMousePressed="#stopSpeed" maxWidth="Infinity">
                                        <graphic><FontIcon iconLiteral="fas-pause" styleClass="buttonIcon"/></graphic>
                                    </Button>

                                </children>
                            </VBox>

                            <Label text="Logs:" textAlignment="CENTER"/>

                            <TextArea fx:id="logArea" editable="false" VBox.vgrow="ALWAYS"/>

                        </VBox>
                    </children>
                </AnchorPane>



                <AnchorPane HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox spacing="10"
                              AnchorPane.topAnchor="10"
                              AnchorPane.bottomAnchor="10"
                              AnchorPane.leftAnchor="10"
                              AnchorPane.rightAnchor="10"
                              VBox.vgrow="ALWAYS">

                            <Label text="Map" textAlignment="CENTER"/>


                            <Pane fx:id="canvasPane" VBox.vgrow="ALWAYS">
                                <children>
                                    <Canvas fx:id="canvas"
                                            width="0" height="0"
                                            AnchorPane.topAnchor="0"
                                            AnchorPane.leftAnchor="0"
                                            AnchorPane.rightAnchor="0"
                                            AnchorPane.bottomAnchor="0" />
                                </children>
                            </Pane>

                            <ToggleButton fx:id="emergencyStopToggle"
                                          text="Emergency Stop"
                                          maxWidth="Infinity"/>

                        </VBox>
                    </children>
                </AnchorPane>



                <AnchorPane HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox spacing="10"
                              AnchorPane.topAnchor="10"
                              AnchorPane.bottomAnchor="10"
                              AnchorPane.leftAnchor="10"
                              AnchorPane.rightAnchor="10"
                              VBox.vgrow="ALWAYS">

                            <Label text="Maneuvers" textAlignment="CENTER"/>

                            <VBox spacing="8" VBox.vgrow="ALWAYS">
                                <children>
                                    <Button fx:id="solveMaze" text="Solve Maze" maxWidth="Infinity"/>
                                    <Button fx:id="lostRobot" text="Lost Robot" maxWidth="Infinity"/>
                                    <Button fx:id="dragRace" text="Drag Race" maxWidth="Infinity"/>

                                    <GridPane hgap="4" vgap="4" VBox.vgrow="ALWAYS">
                                        <columnConstraints>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                        </columnConstraints>
                                        <rowConstraints>
                                            <RowConstraints vgrow="ALWAYS"/>
                                            <RowConstraints vgrow="ALWAYS"/>
                                            <RowConstraints vgrow="ALWAYS"/>
                                        </rowConstraints>

                                        <children>
                                            <Button fx:id="reverseStraight" text="Reverse Straight" maxWidth="Infinity" maxHeight="Infinity"/>
                                            <Button fx:id="reverseCorner" text="Reverse Corner" GridPane.columnIndex="1" maxWidth="Infinity" maxHeight="Infinity"/>
                                            <Button fx:id="threePointTurn" text="Three-Point Turn" GridPane.rowIndex="1" maxWidth="Infinity" maxHeight="Infinity"/>
                                            <Button fx:id="uTurn" text="U-Turn" GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="Infinity" maxHeight="Infinity"/>
                                            <Button fx:id="parkingInBox" text="Parking in a box" GridPane.rowIndex="2" maxWidth="Infinity" maxHeight="Infinity"/>
                                            <Button fx:id="extraSpace" text="Extra Space" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="Infinity" maxHeight="Infinity"/>
                                        </children>
                                    </GridPane>

                                </children>
                            </VBox>

                        </VBox>
                    </children>
                </AnchorPane>

            </children>
        </HBox>

    </children>

</VBox>